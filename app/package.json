{
  "name": "somap-app",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "react-router build",
    "dev": "react-router dev",
    "typecheck": "react-router typegen && tsc",
    "start": "node --enable-source-maps server/entry.js",
    "ingest": "node etl/ingest.ts",
    "scan:external-origins": "node scripts/scan-external-origins.mjs",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@react-router/node": "7.18.2",
    "isbot": "5.2.1",
    "pg": "8.22.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "7.18.2"
  },
  "devDependencies": {
    "@react-router/dev": "7.18.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.1",
    "@types/pg": "8.20.4",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.2.0"
  }
}
