# Template for a deployment's .env, consumed by docker-compose.deploy.yml.
#
#   cp .env.deploy.example .env
#
# Then fill in every value below. Compose refuses to start if any of the three
# required ones is missing -- that is deliberate, not an obstacle: each of them
# has a published default somewhere in this repository, and silently inheriting
# one is the failure this file exists to prevent.
#
# `.env` is gitignored. Do not commit yours.

# ---- required ---------------------------------------------------------------

# The published image tag to run. Pinned, never floating (Principle VII): two
# instances must not silently run different versions of the component computing
# distances. Use an immutable tag -- the `sha-<short>` tags published by
# .github/workflows/publish-images.yml are the intended choice.
#
#   TARROW_IMAGE_TAG=sha-1a2b3c4
TARROW_IMAGE_TAG=

# The database owner's password. Replaces the development composition's
# published `tarrow`. Generate, do not choose:
#
#   openssl rand -base64 32
POSTGRES_PASSWORD=

# The runtime (read-only) role's password. Replaces the literal `tarrow_app`
# that app/sql/schema/010_grants.sql writes and that is published in this
# repository. Set by `migrate` on every run, so changing it here and
# redeploying rotates it. Generate this one too, and make it different:
#
#   openssl rand -base64 32
PGAPPPASSWORD=

# ---- optional ---------------------------------------------------------------

# Where to pull images from. Change this if you have mirrored or rebuilt them
# into your own registry, which Principle VII expects you to be able to do.
#TARROW_REGISTRY=ghcr.io/tarrowhq

# The host interface and port the application is published on.
#
# The default binds loopback only. Raise it to 0.0.0.0 ONLY if something
# outside this host's Docker networks must reach the container directly --
# and read docs/deploy/self-hosting.md first, because that document is where
# what your reverse proxy can see is written down. It is not a small thing:
# the searched address travels in the request body, so a proxy that terminates
# TLS holds the plaintext address, not merely the client's IP.
#TARROW_BIND=127.0.0.1
#TARROW_PORT=3000

# Database name and owner role. Rarely worth changing.
#POSTGRES_USER=tarrow
#POSTGRES_DB=tarrow
